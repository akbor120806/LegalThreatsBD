# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=legalthreadbd

# Secret used to sign JWT session tokens for BOTH the public site and the
# admin panel. Change this to a long random string before deploying.
JWT_SECRET=change_this_to_a_long_random_secret_string

# App URL (used only for reference/links, not required at runtime)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Legal Assistant (optional feature — the site works fine without it,
# the assistant just shows a "not configured" message until this is set).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model used for the assistant.
ANTHROPIC_MODEL=claude-sonnet-5
